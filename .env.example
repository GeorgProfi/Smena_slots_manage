# --- Local development (npm run dev, Postgres in Docker) ---
# DATABASE_URL=postgresql://volunty:volunty@localhost:5432/volunty
# POSTGRES_HOST=localhost

# --- Docker Compose (app + postgres); defaults in docker/app.env ---
# docker compose up --build
# APP_PORT=3000

POSTGRES_USER=volunty
POSTGRES_PASSWORD=volunty
POSTGRES_DB=volunty
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://volunty:volunty@postgres:5432/volunty

SESSION_SECRET=volunty-docker-dev-session-secret-32chars-min

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Прод: https://smenaslots.duckdns.org (см. docker/app.prod.env.example и deploy/nginx/)

CRON_SECRET_KEY=volunty-dev-cron-secret

VAPID_SUBJECT=mailto:admin@localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
