# Dev defaults for `docker compose up --build` (override in .env for secrets in prod)

APP_PORT=3000

POSTGRES_USER=volunty
POSTGRES_PASSWORD=volunty
POSTGRES_DB=volunty
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://volunty:volunty@postgres:5432/volunty

# iron-session (min 32 chars) — change before any public deployment
SESSION_SECRET=volunty-docker-dev-session-secret-32chars-min

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: cron endpoint POST /api/volunteer/send-reminders
CRON_SECRET_KEY=volunty-dev-cron-secret

# Optional: web push
VAPID_SUBJECT=mailto:admin@localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
