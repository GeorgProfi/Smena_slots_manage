# Скопируйте в .env на сервере: cp docker/app.prod.env.example .env

APP_PORT=3000

POSTGRES_USER=volunty
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=volunty
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://volunty:CHANGE_ME_STRONG_PASSWORD@postgres:5432/volunty

SESSION_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS_LONG

NEXT_PUBLIC_APP_URL=https://smenaslots.duckdns.org

CRON_SECRET_KEY=CHANGE_ME_CRON_SECRET

VAPID_SUBJECT=mailto:admin@smenaslots.duckdns.org
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# За nginx с HTTPS (опционально, для логики за прокси)
TRUST_PROXY=true
